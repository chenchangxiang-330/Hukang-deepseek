# 环境变量示例
#
# 用法：
#   1. 复制本文件为 .env
#        cp .env.example .env
#   2. 按需填写下面的值
#   3. .env 已在 .gitignore 中，**不会被提交**
#
# ⚠️ 重要
# - 绝对不要把真实密钥写进本文件（.env.example 是要入库的）
# - 绝对不要把真实密钥写进代码或提交到 git
# - 当前版本（Phase 1～4）**不需要任何密钥就能完整运行**：
#   识别 100% 本地（ML Kit 中文 OCR），联网只查公开的 Open Food Facts

# ---------------------------------------------------------------------------
# 在线视觉识别（可选，当前未接入任何厂商）
#
# 用途：本地 OCR 识别不足时，上传当前食品图片做增强识别。
# 产品要求（PROJECT_SPEC.md §7.10）：第一次上传前必须征得用户同意，
# 且默认关闭；上传前会检查 src/services/vision/consent.ts 的授权状态。
#
# 接入方式：实现 src/services/vision/types.ts 里的 FoodVisionProvider 接口，
# 然后从 Developer Settings 读取本密钥（不入库、不硬编码）。
#
# 留空 = 不启用在线识别，App 只走本地路径。
# ---------------------------------------------------------------------------
VISION_API_KEY=

# 视觉服务的基础地址（换成自建代理或其它厂商时填）
# 留空 = 使用 Provider 内部的默认地址
API_BASE_URL=

# ---------------------------------------------------------------------------
# 说明：以下内容**不需要**配置
#
# - Open Food Facts：公开接口，无需密钥与账号
#   （使用时会带 User-Agent 标识，见 src/services/network/http.ts）
# - Wikidata：公开接口，无需密钥
# - 本地数据库 / 文件存储：都在 App 私有目录，无需配置
# ---------------------------------------------------------------------------

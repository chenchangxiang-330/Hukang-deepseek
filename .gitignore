# 依赖
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# 构建产物（§56：禁止提交）
.gradle/
android/.gradle/
android/**/build/
android/build/
# 本地原生模块（modules/ 下）的构建产物
modules/*/android/build/
modules/*/android/.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties

# 原生生成目录（CNG：由 app.json + config plugin 生成，不入库）
/ios
/android

# 原生签名与凭据
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# 环境变量与密钥（§39：API Key 绝不入库）
.env
.env*.local
secrets.json

# 运行时临时数据：拍摄的食品图片、日志、调试导出
food-images/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Metro
.metro-health-check*

# macOS
.DS_Store


# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# 依赖
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# 构建产物（禁止提交）
.gradle/
android/.gradle/
android/.kotlin/
android/**/build/
android/build/
android/app/.cxx/
# 本地原生模块（modules/ 下）的构建产物
modules/*/android/build/
modules/*/android/.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties

# iOS 原生生成目录（CNG 生成，本项目当前只做 Android）
#
# 注意：android/ **故意不忽略**。
# 它是 CNG 生成目录，但交接版特意把源码保留下来（见 DECISIONS.md D016），
# 这样接手方 git clone 之后不需要先跑 expo prebuild 就能直接 ./gradlew 构建。
# 它的构建产物已在上面单独忽略。
/ios

# 原生签名与凭据
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# 环境变量与密钥（§39：API Key 绝不入库）
.env
.env*.local
secrets.json

# 运行时临时数据：拍摄的食品图片、日志、调试导出
food-images/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Metro
.metro-health-check*

# macOS
.DS_Store

# TypeScript
*.tsbuildinfo
